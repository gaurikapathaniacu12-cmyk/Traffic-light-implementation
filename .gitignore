void setup() {
  // put your setup code here, to run once:
  pinMode(13,OUTPUT); //red
  pinMode(12,OUTPUT);//yellow
  pinMode(11,OUTPUT);//green

}

void loop() {
  // put your main code here, to run repeatedly:
  for(int i=11;i<=13;i++){
    digitalWrite(i,HIGH);
    delay(1000);
    digitalWrite(i,LOW);
    delay(1000);
  }
}
